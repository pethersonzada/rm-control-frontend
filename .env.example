# Para rodar a interface autenticada com npm run dev, configure estes nomes.
# São opções públicas do SDK Web. Credenciais privadas não pertencem ao frontend.
# VITE_APP_MODE=operational
# VITE_API_URL=http://127.0.0.1:8000
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=rm-control-webapp
# VITE_FIREBASE_AUTH_DOMAIN=rm-control-webapp.firebaseapp.com
# VITE_FIREBASE_APP_ID=
