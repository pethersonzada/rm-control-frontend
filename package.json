    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.17.0"
